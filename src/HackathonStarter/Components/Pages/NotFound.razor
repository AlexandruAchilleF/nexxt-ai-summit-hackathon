@page "/not-found"
@layout EmptyLayout

<PageTitle>@T("Not found")</PageTitle>

<div class="d-flex flex-column align-center justify-center gap-3" style="min-height:100vh;text-align:center">
    <MudText Typo="Typo.subtitle2" Color="Color.Primary">404</MudText>
    <MudText Typo="Typo.h4" Style="font-weight:600">@T("Page not found")</MudText>
    <MudText Class="mud-text-secondary">@T("This page doesn't exist or was moved.")</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">@T("Go home")</MudButton>
</div>

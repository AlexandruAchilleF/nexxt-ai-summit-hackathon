@page "/metrics"
@using HackathonStarter.Features.Evaluation
@using HackathonStarter.Features.Rules
@using HackathonStarter.Features.Synthetic
@inject IEvaluationService Evaluation
@implements IDisposable

<PageTitle>@T("Metrics") · @SiteConfig.Name</PageTitle>

<PageHeader Title="@T("Metrics")" />

@if (_running && _report is not null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

@if (_error is not null)
{
    <ErrorState Message="@_error" OnRetry="RunAsync" />
}
else if (_report is not { } r)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    <div class="mt-2"><MudText Typo="Typo.body2" Class="metrics-muted">@T("Running the evaluation...")</MudText></div>
}
else
{
    <section class="metrics-section" aria-labelledby="metrics-spec">
        @SectionHead("metrics-spec", T("1. Specification coverage"))
        @SourceLine(r.Spec.Source)

        @if (r.Spec.Golden.Count == 0 && r.Spec.Synthetic.Count == 0)
        {
            <EmptyState Title="@T("Nothing to evaluate")" Icon="@Icons.Material.Rounded.Rule" />
        }
        else
        {
            @Totals(T("Golden cases"), r.Spec.GoldenTotals, 0)
            @Totals(T("Synthetic clients"), r.Spec.SyntheticTotals, 160)

            <div class="d-flex flex-wrap align-center justify-space-between gap-2 mt-6 mb-2">
                <MudText Typo="Typo.h6">@T("Case by case")</MudText>
                <MudSwitch T="bool" @bind-Value="_onlyFailed" Color="Color.Error" Label="@T("Only the failed ones")" />
            </div>
            <div class="metrics-legend mb-3">
                <span><span class="metrics-rule mono">@T("RULE")</span> @T("expected indicium")</span>
                <span><span class="metrics-rule metrics-rule-cleared mono">@T("RULE")</span> @T("checked, does not apply")</span>
            </div>
            <MudTabs Outlined="true" Rounded="true" Elevation="0" TabPanelsClass="pa-0">
                <MudTabPanel Text="@T("Golden cases ({0})", r.Spec.Golden.Count)">
                    @CaseTable(r.Spec.Golden, golden: true)
                </MudTabPanel>
                <MudTabPanel Text="@T("Synthetic clients ({0})", r.Spec.Synthetic.Count)">
                    @CaseTable(r.Spec.Synthetic, golden: false)
                </MudTabPanel>
            </MudTabs>
        }
    </section>

    <section class="metrics-section" aria-labelledby="metrics-uncertainty">
        @SectionHead("metrics-uncertainty", T("2. Where there is uncertainty"))

        <MudText Typo="Typo.h6" Class="mt-2">@T("Hidden text shield")</MudText>
        @SourceLine(r.Uncertainty.Shield.Source)
        @if (r.Uncertainty.Shield.Documents.Count == 0)
        {
            <EmptyState Title="@T("No documents")" Icon="@Icons.Material.Rounded.PictureAsPdf" />
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var (tally, i) in r.Uncertainty.Shield.ByConcealment.Select((t, i) => (t, i)))
                {
                    <MudItem xs="6" md="3">
                        <StatCard Label="@ConcealmentLabel(tally.Concealment)" Value="@($"{tally.Detected} / {tally.Hidden}")" Delay="@(i * 40)"
                                  Hint="@(tally.Missed > 0 ? T("missed: {0}", tally.Missed) : null)"
                                  Tone="@(tally.Hidden == 0 ? null : tally.Missed == 0 ? "success" : "error")" Icon="@Icons.Material.Rounded.VisibilityOff" />
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <StatCard Label="@T("False alarms on clean documents")" Value="@($"{r.Uncertainty.Shield.FalseAlarms} / {r.Uncertainty.Shield.CleanDocuments}")" Tone="@(r.Uncertainty.Shield.FalseAlarms == 0 ? "success" : "error")"
                              Icon="@Icons.Material.Rounded.Description" />
                </MudItem>
            </MudGrid>
        }

        <MudText Typo="Typo.h6" Class="mt-6">@T("Quotes checked by the evidence verifier")</MudText>
        @SourceLine(r.Uncertainty.Quotes.Source)
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">@QuoteCard(T("True quotes verified"), r.Uncertainty.Quotes.True, verified: true, 0)</MudItem>
            <MudItem xs="12" sm="4">@QuoteCard(T("Quotes only in hidden text, rejected"), r.Uncertainty.Quotes.Hidden, verified: false, 40)</MudItem>
            <MudItem xs="12" sm="4">@QuoteCard(T("Invented quotes rejected"), r.Uncertainty.Quotes.Invented, verified: false, 80)</MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="mt-4">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6">@T("AI extraction from PDFs")</MudText>
                @SourceLine(r.Uncertainty.Extraction.Source)
                <div class="metrics-card"><StatCard Label="@T("Fields extracted correctly")" Icon="@Icons.Material.Rounded.DocumentScanner"
                          Value="@(r.Uncertainty.Extraction is { Fields: { } fields, Correct: { } correct } ? $"{correct} / {fields}" : T("unavailable"))" /></div>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6">@T("Context signals")</MudText>
                @SourceLine(r.Uncertainty.Signals.Source)
                <div class="metrics-card"><StatCard Label="@T("Signals that would have changed a decision")" Value="@(r.Uncertainty.Signals.ChangedDecision?.ToString() ?? T("unavailable"))"
                          Hint="@(r.Uncertainty.Signals.CasesWithSignal.Count == 0 ? T("No case with a signal") : T("Cases with a signal: {0}", string.Join(", ", r.Uncertainty.Signals.CasesWithSignal)))"
                          Icon="@Icons.Material.Rounded.Sensors" /></div>
            </MudItem>
        </MudGrid>
    </section>

    <section class="metrics-section" aria-labelledby="metrics-efficiency">
        @SectionHead("metrics-efficiency", T("3. Efficiency"))
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                @SourceLine(r.Efficiency.Agent)
                <div class="metrics-card"><StatCard Label="@T("Time per case with the agent")" Icon="@Icons.Material.Rounded.SmartToy"
                          Value="@(r.Efficiency.AgentMinutesPerCase is { } agent ? Minutes((decimal)agent) : T("unavailable"))" /></div>
            </MudItem>
            <MudItem xs="12" md="4">
                @SourceLine(r.Efficiency.Manual)
                <div class="metrics-card"><StatCard Label="@T("Manual time per case")" Icon="@Icons.Material.Rounded.Person"
                          Value="@(r.Efficiency.ManualMinutesPerCase is { } manual ? Minutes(manual) : T("unavailable"))" /></div>
            </MudItem>
            <MudItem xs="12" md="4">
                @SourceLine(r.Efficiency.Saved)
                <div class="metrics-card"><StatCard Label="@T("Time saved per case")" Icon="@Icons.Material.Rounded.Timer"
                          Value="@(r.Efficiency.SavedMinutesPerCase is { } saved ? Minutes(saved) : T("unavailable"))" /></div>
            </MudItem>
        </MudGrid>
    </section>
}

@code {
    private EvaluationReport? _report;
    private string? _error;
    private bool _running, _onlyFailed;
    private readonly CancellationTokenSource _cts = new();

    protected override Task OnInitializedAsync() => RunAsync();

    private async Task RunAsync()
    {
        _running = true;
        try
        {
            _error = null;
            _report = await Evaluation.RunAsync(_cts.Token);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        catch (Exception ex) { _error = ex.Message; }
        finally { _running = false; }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    /// <summary>"DL-NEW-90, 26 Jan 2027"; no rule = the guide gives no deadline (FATCA, Q1).</summary>
    private static string DeadlineText(string? ruleId, DateTime? dueAt) =>
        string.Join(", ", new[] { ruleId ?? T("no deadline from the guide"), dueAt is { } d ? CrsUi.Date(d) : null }.OfType<string>());

    private static string OrDash(string text) => string.IsNullOrEmpty(text) ? "—" : text;

    private static string Minutes(decimal minutes) => T("{0} min", Format.Number(minutes, 1));

    private RenderFragment SectionHead(string id, string title) =>
        @<div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-2">
            <MudText Typo="Typo.h5" id="@id" Class="metrics-title">@title</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="RunAsync"
                       Disabled="_running">@T("Run again")</MudButton>
        </div>;

    /// <summary>Real runs need no note; otherwise a pill says why, the reason is on hover.</summary>
    private static RenderFragment SourceLine(SourceNote note) =>
        @<div class="metrics-source">
            @if (note.Source == EvaluationSource.Phase0Placeholder)
            {
                <Pill Tone="warning" Icon="@Icons.Material.Rounded.Construction" Title="@Lang.Pick(note.ReasonRo, note.Reason)">@T("Placeholder")</Pill>
            }
            else if (note.Source != EvaluationSource.Real)
            {
                <Pill Icon="@Icons.Material.Rounded.HourglassEmpty" Title="@Lang.Pick(note.ReasonRo, note.Reason)">@T("Unavailable")</Pill>
            }
        </div>;

    private static RenderFragment Totals(string title, CoverageTotals t, int delay) =>
        @<div class="mb-3">
            <MudText Typo="Typo.subtitle1" Class="metrics-subtitle mb-2">@title</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="6" md="3">
                    <StatCard Label="@T("Caught")" Value="@($"{t.Caught} / {t.ActionsExpected}")" Delay="@delay"
                              Tone="@(t.ActionsExpected > 0 && t.Caught == t.ActionsExpected ? "success" : null)" Icon="@Icons.Material.Rounded.TaskAlt" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <StatCard Label="@T("Missed")" Value="@t.Missed.ToString()" Delay="@(delay + 40)"
                              Tone="@(t.Missed == 0 ? "success" : "error")" Icon="@Icons.Material.Rounded.SearchOff" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <StatCard Label="@T("False alarms")" Value="@t.FalseAlarms.ToString()" Delay="@(delay + 80)"
                              Tone="@(t.FalseAlarms == 0 ? "success" : "error")" Icon="@Icons.Material.Rounded.NotificationsOff" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <StatCard Label="@T("Passed")" Value="@($"{t.Passed} / {t.Evaluated}")" Delay="@(delay + 120)"
                              Tone="@(t.Failed == 0 ? null : "error")" Icon="@Icons.Material.Rounded.Rule" />
                </MudItem>
            </MudGrid>
        </div>;

    private RenderFragment CaseTable(IReadOnlyList<CoverageRow> rows, bool golden)
    {
        var shown = _onlyFailed ? [.. rows.Where(r => r.Status == CoverageStatus.Failed)] : rows;
        return @<div class="metrics-table">
            @if (shown.Count == 0)
            {
                <EmptyState Title="@T("No failed rows")" Icon="@Icons.Material.Rounded.TaskAlt" />
            }
            else
            {
                <MudTable T="CoverageRow" Items="shown" Breakpoint="Breakpoint.Sm" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>@T("Code")</MudTh>
                        <MudTh>@T("Description")</MudTh>
                        <MudTh>@T("Expected")</MudTh>
                        <MudTh>@T("Obtained")</MudTh>
                        <MudTh>@T("Rules")</MudTh>
                        <MudTh>@T("Page")</MudTh>
                        <MudTh>@T("Result")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@T("Code")"><span class="mono">@context.Id</span></MudTd>
                        <MudTd DataLabel="@T("Description")">@Description(context, golden)</MudTd>
                        <MudTd DataLabel="@T("Expected")">@DecisionLabel(context.Expected)</MudTd>
                        <MudTd DataLabel="@T("Obtained")">
                            @if (context.Actual is { } actual)
                            {
                                <span class="@(context.DecisionMatches ? null : "metrics-mismatch")">@DecisionLabel(actual)</span>
                            }
                            else
                            {
                                <span class="metrics-muted">—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="@T("Rules")">@Rules(context)</MudTd>
                        <MudTd DataLabel="@T("Page")"><span class="metrics-nowrap">@Page(context, golden)</span></MudTd>
                        <MudTd DataLabel="@T("Result")">@Status(context)</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </div>;
    }

    private static RenderFragment Rules(CoverageRow row) =>
        @<div class="metrics-rules">
            @foreach (var key in row.ExpectedIndicia)
            {
                <span class="metrics-rule mono" title="@T("Expected indicium")">@key</span>
            }
            @foreach (var key in row.ExpectedCleared)
            {
                <span class="metrics-rule metrics-rule-cleared mono" title="@T("Checked, does not apply")">@key</span>
            }
            @if (row.ExpectedIndicia.Count == 0 && row.ExpectedCleared.Count == 0)
            {
                <span class="metrics-muted">—</span>
            }
            @if (row.MissingIndicia.Count > 0)
            {
                <div class="metrics-mismatch">@T("Missing: {0}", string.Join(", ", row.MissingIndicia))</div>
            }
            @if (row.UnexpectedIndicia.Count > 0)
            {
                <div class="metrics-mismatch">@T("Unexpected: {0}", string.Join(", ", row.UnexpectedIndicia))</div>
            }
            @if (row.MissingCleared.Count > 0)
            {
                <div class="metrics-mismatch">@T("Cleared rule missing: {0}", string.Join(", ", row.MissingCleared))</div>
            }
            @if (row.ReportableMatches == false)
            {
                <div class="metrics-mismatch">@T("Reportable jurisdictions differ")</div>
            }
            @if (row.Deadline is { Matches: false } deadline)
            {
                <div class="metrics-mismatch">@T("Deadline differs from the card: card {0}, calculator {1}", DeadlineText(deadline.Expected.RuleId, deadline.Expected.DueAt),
                    deadline.Actual is { } actual ? DeadlineText(actual.RuleId, actual.DueAt) : T("no case opened"))</div>
            }
            @if (row.Error is not null)
            {
                <div class="metrics-mismatch">@T("The engine failed with {0}", row.Error)</div>
            }
        </div>;

    private static RenderFragment Status(CoverageRow row) => row.Status switch
    {
        CoverageStatus.Passed => @<Pill Tone="success" Icon="@Icons.Material.Rounded.CheckCircle">@T("passed")</Pill>,
        CoverageStatus.Failed => @<Pill Tone="danger" Icon="@Icons.Material.Rounded.Cancel">@T("failed")</Pill>,
        CoverageStatus.Shield => @<Pill Tone="accent" Icon="@Icons.Material.Rounded.Shield" Title="@T("Measured in part 2, by the shield")">@T("Part 2: shield")</Pill>,
        _ => @<Pill Icon="@Icons.Material.Rounded.HourglassEmpty" Title="@T("The card's input is not transcribed yet")">@T("No input")</Pill>,
    };

    private static RenderFragment QuoteCard(string label, QuoteTally tally, bool verified, int delay)
    {
        var count = verified ? tally.Verified : tally.Rejected;
        var tone = tally.Quotes == 0 ? null : count == tally.Quotes ? "success" : "error";
        return @<StatCard Label="@label" Value="@(tally.Quotes == 0 ? T("unavailable") : $"{count} / {tally.Quotes}")" Delay="@delay" Tone="@tone" Icon="@Icons.Material.Rounded.FormatQuote" />;
    }

    /// <summary>Golden titles are written in English and translated in Lang.Ro.Evaluation; the report itself keeps no titles.</summary>
    private static string Description(CoverageRow row, bool golden) =>
        golden
            ? GoldenCases.All.FirstOrDefault(c => c.Id == row.Id)?.Title is { } title ? T(title) : row.ClientCode
            : Lang.Pick(row.Label, row.LabelEn) ?? row.ClientCode;

    /// <summary>The card's pages for a golden case; for a synthetic client, the catalog pages of its expected rules.</summary>
    private static string Page(CoverageRow row, bool golden)
    {
        if (golden)
            return GoldenCases.All.FirstOrDefault(c => c.Id == row.Id)?.GuidePage is { } page ? page == "design" ? T("design") : page : "—";
        var pages = row.ExpectedIndicia.Concat(row.ExpectedCleared).Select(k => k.Split(':', '/')[0]).Distinct()
            .Where(RuleCatalog.Contains).Select(RuleCatalog.Get)
            .Select(rule => rule.Basis == RuleBasis.Interpretation ? T("{0} (interpretation)", rule.GuidePage) : rule.GuidePage).Distinct().ToList();
        return pages.Count == 0 ? "—" : string.Join("; ", pages);
    }

    private static string DecisionLabel(Decision d) => d switch
    {
        Decision.NoCase => T("No case"),
        Decision.Compliant => T("Compliant"),
        Decision.Clarification => T("Clarification"),
        Decision.FatcaAlert => T("FATCA alert"),
        _ => T("Shield alert"),
    };

    private static string ConcealmentLabel(Concealment c) => c switch
    {
        Concealment.White => T("White text"),
        Concealment.Tiny => T("Tiny font"),
        Concealment.OffPage => T("Off the page"),
        _ => T("Invisible text"),
    };
}

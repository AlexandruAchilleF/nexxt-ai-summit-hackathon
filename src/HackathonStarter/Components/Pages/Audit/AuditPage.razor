@page "/audit"
@using HackathonStarter.Features.Audit
@using HackathonStarter.Features.Cases
@inject IAuditLog Audit
@inject ICaseService Cases
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject CurrentUser CurrentUser
@implements IDisposable

<PageTitle>@T("Audit log") · @SiteConfig.Name</PageTitle>

<PageHeader Title="@T("Audit log")" Description="@T("The bank keeps a record that can credibly prove each confirmation, for audit purposes, and its electronic system must ensure that the information received is the information sent (ANAF guide, p. 34-35). Each entry is chained to the previous one with SHA-256: a change breaks the chain exactly there.")">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Verified" OnClick="VerifyAsync"
                   Disabled="@(_entries is null || _verifying)">@T("Verify")</MudButton>
    </Actions>
</PageHeader>

@if (_verification is { } v)
{
    <MudAlert Severity="@(v.Ok ? Severity.Success : Severity.Error)" Class="mb-4 crs-swap" Style="display:flex" @key="_sweep">
        @(v.Ok ? T("Chain intact: {0} entries checked", v.Checked) : T("Chain broken at entry #{0}", v.FirstBrokenSeq))
    </MudAlert>
}

@if (_error is not null)
{
    <ErrorState Message="@_error" OnRetry="LoadAsync" />
}
else if (_entries is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" Width="360px" Style="border-radius:12px" Class="mb-4" />
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="360px" Style="border-radius:20px" />
}
else if (_entries.Count == 0)
{
    <EmptyState Title="@T("No entries yet")" Description="@T("Every change, rule, case step, evidence check and approval is written here.")" Icon="@Icons.Material.Rounded.Verified">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/changes/new">@T("Record a change")</MudButton>
    </EmptyState>
}
else
{
    <div class="d-flex flex-wrap align-center gap-3 mb-4">
        <Segmented Label="@T("Audit log")" @bind-Value="_view" Options="@([
            new("steps", T("Steps and decisions"), _entries.Count(e => e.Kind != AuditKinds.RuleApplied)),
            new("all", T("Everything"), _entries.Count)])" />
        <span class="crs-hint" style="margin:0">@(_view == "steps" ? T("The rule checks of each change are hidden; they stay in the chain.") : T("Including every rule checked on every change."))</span>
    </div>
    <div class="@($"audit-table{(_verification is null ? "" : _verification.Ok ? " is-swept" : " is-broken")}")" @key="@($"{_sweep}|{_view}")">
        <MudTable T="AuditEntry" Items="Shown" Breakpoint="Breakpoint.Sm" Dense="true" Hover="true" Outlined="true" Elevation="0" RowStyleFunc="RowStyle" RowClassFunc="RowClass">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>@T("When")</MudTh>
                <MudTh>@T("Actor")</MudTh>
                <MudTh>@T("Case")</MudTh>
                <MudTh>@T("Kind")</MudTh>
                <MudTh>@T("Payload")</MudTh>
                <MudTh>@T("Hash")</MudTh>
                @if (_isAdmin && _tamperMode)
                {
                    <MudTh></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#" Style="white-space:nowrap">
                    <span class="audit-link" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.Link" /></span>
                    <span class="audit-seq mono">@context.Seq</span>
                    @if (context.Seq == _verification?.FirstBrokenSeq)
                    {
                        <Pill Tone="danger" Icon="@Icons.Material.Rounded.LinkOff">@T("broken here")</Pill>
                    }
                    else if (context.Seq > _verification?.FirstBrokenSeq)
                    {
                        <Pill>@T("after a break")</Pill>
                    }
                </MudTd>
                <MudTd DataLabel="@T("When")"><span style="white-space:nowrap">@CrsUi.DateTimeText(context.At)</span></MudTd>
                <MudTd DataLabel="@T("Actor")"><span style="white-space:nowrap">@CrsUi.Actor(context.Actor)</span></MudTd>
                <MudTd DataLabel="@T("Case")">
                    @if (context.CaseId is { } id && _codes.TryGetValue(id, out var caseCode))
                    {
                        <a class="crs-code" href="@($"/cases/{caseCode}")" style="white-space:nowrap">@caseCode</a>
                    }
                    else
                    {
                        <span class="crs-hint">-</span>
                    }
                </MudTd>
                <MudTd DataLabel="@T("Kind")"><span style="white-space:nowrap" title="@context.Kind">@CrsUi.AuditKind(context.Kind)</span></MudTd>
                <MudTd DataLabel="@T("Payload")" Class="audit-payload"><span class="audit-ellipsis" title="@context.PayloadJson">@Readable(context.PayloadJson)</span></MudTd>
                <MudTd DataLabel="@T("Hash")"><span class="mono" title="@context.Hash">@context.Hash[..Math.Min(12, context.Hash.Length)]</span></MudTd>
                @if (_isAdmin && _tamperMode)
                {
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Rounded.EditNote" Size="Size.Small" Color="Color.Error" aria-label="@T("Tamper")"
                                       title="@T("Tamper")" OnClick="() => TamperAsync(context)" />
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    </div>
}

@code {
    private IReadOnlyList<AuditEntry>? _entries;
    private Dictionary<int, string> _codes = [];
    private AuditVerification? _verification;
    private string _view = "steps";
    private string? _error;
    private bool _isAdmin, _verifying;
    private int _sweep;
    private bool _tamperMode;

    [CascadingParameter] public DemoContext? Demo { get; set; }
    /// <summary>?tamper=1 turns tamper mode on (also from the Demo menu).</summary>
    [SupplyParameterFromQuery(Name = "tamper")] public string? Tamper { get; set; }

    private IEnumerable<AuditEntry> Shown => _view == "all" ? _entries! : _entries!.Where(e => e.Kind != AuditKinds.RuleApplied);

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await CurrentUser.GetAsync()).Role == Roles.Admin; // the service checks it again
        _tamperMode = Tamper is not null;
        OfferDemo();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _entries = await Audit.ListAsync();
            _codes = (await Cases.QueueAsync(new CaseQueueFilter(OpenOnly: false))).ToDictionary(c => c.Id, c => c.Code);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task VerifyAsync()
    {
        _verifying = true;
        try
        {
            _verification = await Audit.VerifyAsync();
            _sweep++; // restarts the sweep down the chain
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _verifying = false; }
    }

    private async Task TamperAsync(AuditEntry entry)
    {
        if (!await Dialogs.ConfirmAsync(T("Tamper with entry #{0}?", entry.Seq),
                T("Demo only: the payload is changed directly in the database, without recomputing its hash. Verify then finds this entry."),
                T("Tamper"), destructive: true)) return;
        try
        {
            await Audit.TamperAsync(entry.Seq);
            _verification = null;
            Snackbar.Add(T("Entry #{0} was edited outside the application", entry.Seq), Severity.Warning);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    /// <summary>Tamper is a demo of the hash chain, not an operator task: it is switched on from the Demo menu.</summary>
    private void OfferDemo()
    {
        if (Demo is null || !_isAdmin) return;
        Demo.Offer(this, T("Audit log"),
        [
            new(_tamperMode ? T("Hide the tamper buttons") : T("Tamper mode"), Icons.Material.Rounded.EditNote,
                () => { _tamperMode = !_tamperMode; OfferDemo(); return InvokeAsync(StateHasChanged); },
                _tamperMode ? null : T("edit an entry behind the app's back"), Destructive: !_tamperMode),
        ]);
    }

    /// <summary>The payload as "key: value" pairs (codes, IDs, statuses; already masked); the raw JSON stays in the tooltip.</summary>
    private static string Readable(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object) return json;
            return string.Join(" · ", doc.RootElement.EnumerateObject()
                .Where(p => p.Value.ValueKind is not (System.Text.Json.JsonValueKind.Null or System.Text.Json.JsonValueKind.Undefined))
                .Select(p => $"{p.Name}: {(p.Value.ValueKind == System.Text.Json.JsonValueKind.Array ? string.Join(", ", p.Value.EnumerateArray().Select(v => v.ToString())) : p.Value.ToString())}"));
        }
        catch (System.Text.Json.JsonException) { return json; }
    }

    public void Dispose() => Demo?.Withdraw(this);

    private string RowStyle(AuditEntry entry, int index) =>
        $"--i:{Math.Min(index, 40)}" + (entry.Seq == _verification?.FirstBrokenSeq ? ";background: var(--app-danger-tint)" : "");

    private string RowClass(AuditEntry entry, int _) =>
        entry.Seq == _verification?.FirstBrokenSeq ? "is-break" : entry.Seq > _verification?.FirstBrokenSeq ? "is-after" : "";
}

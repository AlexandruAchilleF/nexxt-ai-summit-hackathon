@page "/"
@layout LandingLayout
@inject NavigationManager Nav

<PageTitle>@SiteConfig.Name</PageTitle>

@* Landing page. All copy lives in SiteConfig.Landing; set Enabled = false to skip it. Styles: wwwroot/landing.css *@
<div class="lp">
    <LandingHeader />

    <main>
        <section class="lp-wrap lp-hero">
            <p class="lp-eyebrow">@T("CRS/FATCA operations")</p>
            <h1>@L.Headline</h1>
            <p class="lp-hero-sub">@L.Subheadline</p>
            <div class="lp-hero-actions">
                <a class="lp-btn lp-btn-light" href="@L.CtaHref">@L.CtaLabel</a>
            </div>
            <p class="lp-demo-note"><MudIcon Icon="@Icons.Material.Outlined.Science" Size="Size.Small" />@T("Demonstration with synthetic customer data.")</p>
        </section>

        <div class="lp-wrap"><AppPreview /></div>

        <section id="product" class="lp-wrap lp-statement">
            <div>
                <p class="lp-eyebrow">@T("The compliance problem")</p>
                <h2>@T("From customer changes to a documented review")</h2>
            </div>
            <div class="lp-problem-copy">
                <p>@T("A relevant customer change can make the existing tax-residency declaration unreliable. The bank needs to reassess the file, collect evidence and track the applicable deadline.")</p>
                <p class="lp-dim">@L.Statement.Rest</p>
            </div>
        </section>

        @foreach (var s in L.Sections)
        {
            <section class="lp-section">
                <div class="lp-wrap">
                    <div class="lp-section-head">
                        <h2>@s.Title</h2>
                        <p>@s.Description</p>
                    </div>
                    <div class="lp-features">
                        @foreach (var f in s.Features)
                        {
                            <div class="lp-feature">
                                <span class="lp-feature-icon"><MudIcon Icon="@f.Icon" /></span>
                                <h3>@f.Title</h3>
                                <p>@f.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <section id="how" class="lp-section">
            <div class="lp-wrap">
                <h2 class="lp-big">@T("How it works")</h2>
                <ol class="lp-steps" style="--n:@L.Steps.Length">
                    @foreach (var step in L.Steps)
                    {
                        <li><h3>@step.Title</h3><p>@step.Description</p></li>
                    }
                </ol>
                <div class="lp-audit">
                    <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" />
                    <div>
                        <h3>@T("A verifiable audit trail")</h3>
                        <p>@T("Case changes and approvals are recorded in a hash-chained log. The chain can be checked for altered entries.")</p>
                    </div>
                    <a href="/audit">@T("Audit log")<MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" /></a>
                </div>
            </div>
        </section>

        <section class="lp-closing">
            <h2><span>@L.Closing.Lead</span><br />@L.Closing.Rest</h2>
            <div class="lp-closing-actions">
                <a class="lp-btn lp-btn-light" href="@L.CtaHref">@L.CtaLabel</a>
            </div>
        </section>
    </main>

    <LandingFooter />
</div>

@code {
    private static Landing L => SiteConfig.Landing;

    protected override void OnInitialized()
    {
        if (!L.Enabled) Nav.NavigateTo(SiteConfig.Nav[0].Href, replace: true);
    }
}

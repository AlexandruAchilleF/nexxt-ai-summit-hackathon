@page "/architecture"
@using HackathonStarter.Features.Audit
@using HackathonStarter.Features.Rules
@using HackathonStarter.Features.Sentinel
@inject IEnumerable<AgentDefinition> Agents
@inject ChatClientProvider Ai
@inject IServiceProvider Services
@inject CurrentUser CurrentUser
@inject IAuditLog Audit

<PageTitle>@T("Architecture") · @SiteConfig.Name</PageTitle>

@* "How it works", filmed for the architecture part of the pitch (S7). Every number on it is read live. *@
<PageHeader Title="@T("How {0} decides", SiteConfig.Name)" Description="@T("Code decides. AI explains. A person approves.")" />

<ol class="arch-flow mb-3" aria-label="@T("Maria's case, step by step")">
    @foreach (var (step, i) in Flow.Select((s, i) => (s, i)))
    {
        <li class="@($"arch-step arch-{step.Who}")">
            <span class="arch-num">@(i + 1)</span>
            <span class="arch-text">@T(step.Text)</span>
            <span class="arch-who">@WhoLabel(step.Who)</span>
        </li>
    }
</ol>

<div class="arch-chain mb-6">
    <MudIcon Icon="@Icons.Material.Outlined.Link" Size="Size.Small" />
    <span>@T("Every step is written to the hash-chained audit log.")</span>
    @if (_chain is { } v)
    {
        <a href="/audit" class="arch-chain-link">
            @if (v.Ok)
            {
                <Pill Tone="success" Icon="@Icons.Material.Rounded.Verified">@T("intact · {0} entries", v.Checked)</Pill>
            }
            else
            {
                <Pill Tone="danger" Icon="@Icons.Material.Rounded.LinkOff">@T("broken at entry #{0}", v.FirstBrokenSeq ?? 0)</Pill>
            }
        </a>
    }
</div>

<div class="arch-cols mb-6">
    <section class="arch-col arch-code">
        <h2>@T("Code decides")</h2>
        <ul>
            <li>@RulesLine</li>
            <li>@T("Deadlines by rule: {0} for a new account, {1} for a pre-existing one", RuleIds.DeadlineNew90, RuleIds.DeadlinePreexistingYear)</li>
            <li>@T("The shield removes hidden text before any model reads a document")</li>
            <li>@T("Every quote is checked against the document's visible text")</li>
        </ul>
        <p class="arch-never"><MudIcon Icon="@Icons.Material.Outlined.Block" Size="Size.Small" />@T("It never asks a model whether a rule applies.")</p>
    </section>

    <section class="arch-col arch-ai">
        <h2>@T("AI explains")</h2>
        <ul>
            <li>@T("{0}: {1} tools, {2} of them wait for a person", SiteConfig.Name, _tools.Count, _tools.Count(t => t.NeedsApproval))</li>
            <li>@T("Reads the documents, quotes the evidence and drafts the letter in the client's language")</li>
            <li>@ModelLine</li>
            <li>@T("{0} checks on every answer: no personal data, every quote verified", _checks)</li>
            <li>@T("National ID, IBAN, card, email and phone are masked before the model")</li>
        </ul>
        <p class="arch-never"><MudIcon Icon="@Icons.Material.Outlined.Block" Size="Size.Small" />@T("It never decides and never sends.")</p>
    </section>

    <section class="arch-col arch-person">
        <h2>@T("A person approves")</h2>
        <ul>
            <li>@T("Sending the letter to the client")</li>
            <li>@T("Closing the case")</li>
            <li>@T("A four-eyes warning when the approver also drafted it")</li>
            <li>@T("Moving the demo date and Tamper are admin only")</li>
        </ul>
        <p class="arch-never"><MudIcon Icon="@Icons.Material.Outlined.Block" Size="Size.Small" />@T("Nothing irreversible happens in one click.")</p>
    </section>
</div>

@if (_tools.Count > 0)
{
    <div class="arch-tools mb-6">
        <span class="arch-tools-label">@T("The agent's tools")</span>
        @foreach (var t in _tools)
        {
            <span class="@(t.NeedsApproval ? "arch-tool arch-tool-gated" : "arch-tool")" title="@t.Description">@t.Name@if (t.NeedsApproval) {<MudIcon Icon="@Icons.Material.Outlined.HowToReg" Size="Size.Small" />}</span>
        }
        <span class="arch-tools-note"><MudIcon Icon="@Icons.Material.Outlined.HowToReg" Size="Size.Small" />@T("waits for a person's approval")</span>
    </div>
}

<MudPaper Outlined="true" Class="pa-4 d-flex align-start gap-3">
    <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Class="mud-text-secondary mt-1" />
    <div>
        <MudText Typo="Typo.subtitle2">@T("In a bank")</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@T("In the demo, the form simulates each change. In a bank, core banking would send every change to the same service, and the same rules would run.")</MudText>
    </div>
</MudPaper>

@code {
    private record Step(string Text, string Who);

    // Maria's route (PLAN.md 6.3): who acts at each step is the point of the page.
    private static readonly Step[] Flow =
    [
        new("A change comes in", "code"),
        new("The rules are applied by code", "code"),
        new("A case opens with its deadline", "code"),
        new("The agent reads and quotes the file", "ai"),
        new("A person approves the letter", "person"),
        new("Code checks the answer again", "code"),
        new("A person approves the closing", "person"),
        new("Closed with the proof", "code"),
    ];

    private List<AgentTool> _tools = [];
    private int _checks;
    private AuditVerification? _chain;

    private static string WhoLabel(string who) => who switch
    {
        "ai" => T("AI"),
        "person" => T("Person"),
        _ => T("Code"),
    };

    private static string RulesLine
    {
        get
        {
            var all = RuleCatalog.All;
            return T("{0} rules, each with an ID and a source: {1} from the text of the law, {2} our reading, {3} bank policy",
                all.Count, all.Count(r => r.Basis == RuleBasis.Verified), all.Count(r => r.Basis == RuleBasis.Interpretation),
                all.Count(r => r.Basis == RuleBasis.Policy));
        }
    }

    private string ModelLine
    {
        get
        {
            if (!Ai.IsConfigured) return T("No model set: the simulation runs the same real tools");
            var o = Ai.Options;
            return string.Equals(o.Provider, "Bedrock", StringComparison.OrdinalIgnoreCase)
                ? T("Model: {0} on Amazon Bedrock, {1}", o.Model, o.BedrockRegion)
                : T("Model: {0} ({1})", o.Model, o.Provider);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var sentinel = Agents.FirstOrDefault(a => a.Name == SentinelTools.AgentName);
        if (sentinel is ToolAgent ta)
        {
            _tools = ta.Tools(new ToolContext(await CurrentUser.GetAsync(), [], Services)).ToList();
            _checks = ta.Checks.Length;
        }
        _chain = await Audit.VerifyAsync();
    }
}

@* Footer of the landing page and the public pages: app pages by nav group, then /privacy (see AppFooter). *@
<footer class="lp-footer">
    <div class="lp-wrap lp-footer-grid" style="--cols:@(Groups.Length + 1)">
        <div class="lp-footer-brand"><BrandLogo Compact="true" /></div>
        @foreach (var group in Groups)
        {
            <div>
                <h3>@T(group.Key == "" ? "Product" : group.Key)</h3>
                @foreach (var item in group.Take(5))
                {
                    <a href="@item.Href">@T(item.Label)</a>
                }
            </div>
        }
        <div>
            <h3>@T("Legal")</h3>
            <a href="/privacy">@T("Data and privacy")</a>
        </div>
    </div>
    <p class="lp-wrap lp-footer-legal">© @DateTime.UtcNow.Year @SiteConfig.Legal.CompanyName</p>
</footer>

@code {
    // The first two nav groups (ungrouped pages first), so renaming or hiding groups never leaves an empty column.
    private static readonly IGrouping<string, NavItem>[] Groups =
        SiteConfig.Nav.GroupBy(n => n.Group ?? "").Where(g => g.Key != "Account").Take(2).ToArray();
}

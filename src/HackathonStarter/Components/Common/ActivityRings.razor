@* Part-of-whole for up to three categories as concentric rings with the total in the middle; hover a legend row to focus it. *@
<div class="app-rings">
    <svg width="168" height="168" viewBox="0 0 180 180" role="img" aria-label="@string.Join(", ", Segments.Select(s => $"{s.Label} {s.Value}"))">
        @for (var i = 0; i < Math.Min(3, Segments.Count); i++)
        {
            var r = 80 - i * 20;
            var len = 2 * Math.PI * r;
            var off = len * (1 - (_total == 0 ? 0 : Segments[i].Value / _total));
            <circle class="track" cx="90" cy="90" r="@r" stroke-width="13" />
            <circle class="ring" data-k="@i" cx="90" cy="90" r="@r" stroke-width="13" transform="rotate(-90 90 90)"
                    style="@FormattableString.Invariant($"stroke:{Segments[i].Color};stroke-dasharray:{len:0.##};--len:{len:0.##};--off:{off:0.##};animation-delay:{i * 120}ms")" />
        }
        <text class="total" x="90" y="96" text-anchor="middle">@_total.ToString("0")</text>
        <text class="unit" x="90" y="114" text-anchor="middle">@Unit</text>
    </svg>
    <div class="app-rings-legend">
        @for (var i = 0; i < Math.Min(3, Segments.Count); i++)
        {
            <div data-k="@i">
                <span class="sw" style="background:@Segments[i].Color"></span>@Segments[i].Label
                <span class="n">@Segments[i].Value.ToString("0")</span>
                <span class="pct">@(_total == 0 ? "0" : Math.Round(Segments[i].Value / _total * 100).ToString("0"))%</span>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Biggest first; colors as CSS values (e.g. "var(--app-accent)").</summary>
    [Parameter, EditorRequired] public IReadOnlyList<(string Label, double Value, string Color)> Segments { get; set; } = [];
    [Parameter] public string Unit { get; set; } = "";

    private double _total;

    protected override void OnParametersSet() => _total = Segments.Sum(s => s.Value);
}

<div class="d-flex flex-wrap align-end justify-space-between gap-4 page-header app-enter">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">@Title</MudText>
        @if (!string.IsNullOrEmpty(Description))
        {
            <MudText Typo="Typo.body1" Class="page-description">@Description</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="d-flex flex-wrap gap-2">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}

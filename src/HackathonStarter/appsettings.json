{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "RecreateOnStartup": false
  },
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "AI": {
    "Provider": "None",
    "Model": "claude-sonnet-5-5",
    "ApiKey": "",
    "Endpoint": "",
    "StructuredOutputs": false,
    "ToolMode": "Auto",
    "AgentMode": "Auto",
    "Record": false,
    "MaxSteps": 8,
    "TimeoutSeconds": 60,
    "ToolTimeoutSeconds": 15,
    "ReplayMinSimilarity": 0.5,
    "MaxHistoryChars": 24000,
    "MaskPii": true,
    "InputPricePerMillion": 0,
    "OutputPricePerMillion": 0
  },
  "Privacy": {
    "RedactRecordings": true,
    "RetentionDays": 30
  },
  "Targets": {
    "assistant": { "Kind": "Agent", "Agent": "assistant", "Label": "Built-in assistant" }
  },
  "Checks": {
    "PhraseRules": []
  },
  "Security": {
    "AccessCode": "",
    "ApiKey": "",
    "ApiUser": "member",
    "AllowedOrigins": "",
    "AgentRunsPerMinute": 10,
    "DailyLiveRunBudget": 300
  }
}

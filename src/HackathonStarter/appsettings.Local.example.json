{
  "//": "Copy to appsettings.Local.json (git-ignored) and keep ONE AI block. Never commit API keys.",

  "AI": {
    "Provider": "Anthropic",
    "Model": "claude-sonnet-5-5",
    "ApiKey": "sk-ant-..."
  },

  "AI_Profiles_example": {
    "//": "Merge into the AI block above as \"Profiles\". Unset fields inherit; another provider never inherits the main ApiKey.",
    "Profiles": {
      "attacker": { "Provider": "OpenAI", "Endpoint": "http://YOUR-GPU-SERVER:8000/v1", "Model": "your-local-model" },
      "judge": { "Model": "claude-haiku-5-5" }
    }
  },

  "//Targets": "Rename Targets_example to Targets (copy only the entries you need). Kind: OpenAI (any OpenAI-compatible API), Http (any JSON API) or Agent.",
  "Targets_example": {
    "bank-bot": { "Kind": "OpenAI", "Endpoint": "http://YOUR-GPU-SERVER:8000/v1", "Model": "your-model", "SystemPrompt": "You are the virtual assistant of a bank..." },
    "partner-api": { "Kind": "Http", "Endpoint": "https://api.example.com/chat", "ApiKey": "...", "RequestTemplate": "{\"question\": {{message}}}", "ResponsePath": "data.answer" }
  },

  "Checks_example": {
    "PhraseRules": [
      { "Id": "no-crypto", "Title": "No crypto recommendations", "Mode": "MustNotContain", "Phrases": ["bitcoin", "criptomonede"] }
    ]
  },

  "AI_Bedrock_example": {
    "//": "Amazon Bedrock. No key here: credentials come from the AWS chain (AWS_* environment variables, a profile, or the IAM role).",
    "Provider": "Bedrock",
    "Region": "us-west-2",
    "Model": "us.anthropic.claude-sonnet-5-5",
    "Profiles": {
      "extract": { "Model": "us.anthropic.claude-haiku-5-5" }
    }
  },
  "AI_Featherless_example": {
    "Provider": "OpenAI",
    "Endpoint": "https://api.featherless.ai/v1",
    "ApiKey": "...",
    "Model": "meta-llama/Meta-Llama-3.1-8B-Instruct"
  },
  "AI_OpenAI_example": {
    "Provider": "OpenAI",
    "ApiKey": "sk-...",
    "Model": "gpt-4o-mini",
    "StructuredOutputs": true
  },
  "AI_AzureOpenAI_example": {
    "Provider": "AzureOpenAI",
    "Endpoint": "https://YOUR-RESOURCE.openai.azure.com/",
    "ApiKey": "...",
    "Model": "your-deployment-name",
    "StructuredOutputs": true
  },
  "AI_Ollama_example": {
    "Provider": "OpenAI",
    "Endpoint": "http://localhost:11434/v1",
    "Model": "llama3.2"
  },

  "Database_Postgres_example": {
    "Provider": "Postgres"
  },
  "ConnectionStrings_Postgres_example": {
    "Default": "Host=...;Database=...;Username=...;Password=...;SSL Mode=Require"
  }
}
